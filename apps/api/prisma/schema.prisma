generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMERACIONES
// ============================================================

enum Rol {
  ADMIN
  COORDINADOR
}

enum Estado_Sesion {
  PENDING
  INICIADA
  FINALIZADA
  ABANDONADA
  DEGRADADA
}

enum Tipo_Stream {
  CAMARA
  PANTALLA
}

enum Veredicto {
  PENDIENTE_REVISION
  CONFIRMADO
  FALSO_POSITIVO
  DUDOSO
}

enum Nivel_Riesgo {
  BAJO
  MEDIO
  ALTO
  CRITICO
}

enum Estado_Eliminacion {
  PENDIENTE
  PROGRAMADA
  ELIMINADA
  FALLO
}

// ============================================================
// IDENTIDAD DEL PERSONAL
// ============================================================

model Usuario {
  ID_Usuario     Int      @id @default(autoincrement())
  Nombre         String
  Email          String   @unique
  Password_Hash  String
  Rol            Rol
  Activo         Boolean  @default(true)
  Creado_En      DateTime @default(now())

  auditorias AuditoriaAcceso[]
}

// ============================================================
// CONTEXTO ACADÉMICO
// ============================================================

model Carrera {
  ID_Carrera      Int    @id @default(autoincrement())
  Nombre_Carrera  String

  carrera_asignaturas Carrera_Asignatura[]
  estudiantes Estudiante[]
}

model Carrera_Asignatura {
  ID_Carrera      Int
  ID_Asignatura   Int

  carrera     Carrera    @relation(fields: [ID_Carrera], references: [ID_Carrera], onDelete: Cascade)
  asignatura Asignatura @relation(fields: [ID_Asignatura], references: [ID_Asignatura], onDelete: Cascade)

  @@id([ID_Carrera, ID_Asignatura])
}

model Asignatura {
  ID_Asignatura      Int    @id @default(autoincrement())
  Nombre_Asignatura  String
  Anio_Semestre      String

  carrera_asignaturas Carrera_Asignatura[]
  estudiantes Estudiante_Asignatura[]
  pruebas Prueba[]
}

model Estudiante {
  ID_Estudiante       Int       @id @default(autoincrement())
  Nombre              String
  RUT                 String?
  Token_Moodle        String    @unique
  Consentimiento      Boolean   @default(false)
  Consentimiento_Fecha DateTime?
  ID_Carrera          Int

  carrera     Carrera @relation(fields: [ID_Carrera], references: [ID_Carrera], onDelete: Cascade)

  asignaturas Estudiante_Asignatura[]
  sesiones    Sesion_Examen[]
}

model Estudiante_Asignatura {
  ID_Estudiante Int
  ID_Asignatura Int

  estudiante Estudiante @relation(fields: [ID_Estudiante], references: [ID_Estudiante], onDelete: Cascade)
  asignatura Asignatura @relation(fields: [ID_Asignatura], references: [ID_Asignatura], onDelete: Cascade)

  @@id([ID_Estudiante, ID_Asignatura])
  @@index([ID_Asignatura])
}

// ============================================================
// PRUEBAS
// ============================================================

model Prueba {
  ID_Prueba            Int      @id @default(autoincrement())
  Nombre_Prueba        String
  Fecha                DateTime
  Duracion_Min         Int
  Requiere_Proctoring  Boolean  @default(true)
  Activa               Boolean  @default(true)
  Streams_Para_Grabar  String   @default("[\"CAMARA\",\"PANTALLA\"]")
  Categorias_Activas   String   @default("[]")
  ID_Asignatura        Int

  asignatura Asignatura @relation(fields: [ID_Asignatura], references: [ID_Asignatura], onDelete: Cascade)

  sesiones Sesion_Examen[]

  @@index([ID_Asignatura])
}

// ============================================================
// SESIONES DE EXAMEN
// ============================================================

model Sesion_Examen {
  ID_Sesion     Int      @id @default(autoincrement())
  Token_Acceso  String   @unique
  Token_Expira  DateTime
  Hora_Inicio   DateTime?
  Hora_Fin      DateTime?
  Duracion_Real Int?
  Estado        Estado_Sesion @default(PENDING)
  Nivel_Riesgo  Nivel_Riesgo  @default(BAJO)
  Puntaje_Total Int      @default(0)
  IP            String?
  User_Agent    String?
  ID_Prueba     Int
  ID_Estudiante Int

  prueba     Prueba @relation(fields: [ID_Prueba], references: [ID_Prueba], onDelete: Cascade)
  estudiante Estudiante @relation(fields: [ID_Estudiante], references: [ID_Estudiante], onDelete: Cascade)

  grabaciones Grabacion[]
  incidentes  Incidente[]
}

model Revision_Incidente {
  ID_Revision  Int      @id @default(autoincrement())
  Veredicto    Veredicto @default(PENDIENTE_REVISION)
  Fecha        DateTime @default(now())
  ID_Incidente Int

  incidente Incidente @relation(fields: [ID_Incidente], references: [ID_Incidente], onDelete: Cascade)

  @@index([ID_Incidente])
}

model AuditoriaAcceso {
  ID_Auditoria Int      @id @default(autoincrement())
  ID_Usuario   Int
  ID_Grabacion Int
  Accion       String   // visualizar | descargar
  IP           String
  User_Agent   String?
  Fecha        DateTime @default(now())

  usuario Usuario @relation(fields: [ID_Usuario], references: [ID_Usuario], onDelete: Cascade)

  @@index([ID_Usuario, Fecha])
  @@index([ID_Grabacion])
}

// ============================================================
// EVIDENCIA MULTIMEDIA
// ============================================================

model Grabacion {
  ID_Grabacion        Int      @id @default(autoincrement())
  Tipo_Stream         Tipo_Stream
  Indice_Chunk        Int
  Ruta_Video          String   @unique
  Hash_Sha256         String?
  Fecha_Eliminacion_Programada DateTime?
  Estado_Eliminacion  Estado_Eliminacion @default(PENDIENTE)
  Eliminado_En        DateTime?
  ID_Sesion           Int

  sesion Sesion_Examen @relation(fields: [ID_Sesion], references: [ID_Sesion], onDelete: Cascade)

  @@unique([ID_Sesion, Tipo_Stream, Indice_Chunk])
  @@index([ID_Sesion, Tipo_Stream, Indice_Chunk])
  @@index([Fecha_Eliminacion_Programada])
  @@index([Hash_Sha256])
}

// ============================================================
// INCIDENTES
// ============================================================

model Incidente {
  ID_Incidente      Int @id @default(autoincrement())
  Descripcion       String?
  Tiempo            DateTime @default(now())
  Duracion          Float
  Puntaje_Incidente Float    @default(0)
  Probabilidad      Float
  Metadatos         String?
  ID_Categoria      Int
  ID_Sesion         Int

  categoria Categoria_Incidente @relation(fields: [ID_Categoria], references: [ID_Categoria], onDelete: Cascade)
  sesion     Sesion_Examen @relation(fields: [ID_Sesion], references: [ID_Sesion], onDelete: Cascade)

  revisiones Revision_Incidente[]

  @@index([ID_Sesion, Tiempo])
  @@index([ID_Categoria])
  @@index([Tiempo])
}

// ============================================================
// CONFIGURACIÓN DE RIESGO
// ============================================================

model Categoria_Incidente {
  ID_Categoria      Int     @id @default(autoincrement())
  Nombre_Categoria  String
  Descripcion       String?
  Activo            Boolean @default(true)

  incidentes Incidente[]
  reglas     Regla_Puntaje[]
}

model Regla_Puntaje {
  ID_Regla_Puntaje Int      @id @default(autoincrement())
  Puntaje          Float    @default(0)
  Puntaje_Tope     Float    @default(0)
  Minimo           Int      @default(1)
  Maximo           Int      @default(50)
  Activo           Boolean  @default(true)
  Actualizado_En   DateTime @updatedAt
  ID_Categoria     Int      @unique

  categoria Categoria_Incidente @relation(fields: [ID_Categoria], references: [ID_Categoria], onDelete: Cascade)
}