{
    "name": "@proctoring/api",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev",
        "db:deploy": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "db:seed": "tsx src/prisma/seed.ts"
    },
    "dependencies": {
        "@fastify/cors": "^10.0.1",
        "@fastify/jwt": "^9.0.1",
        "@prisma/client": "^6.1.0",
        "@proctoring/shared": "workspace:*",
        "fastify": "^5.2.0",
        "ioredis": "^5.4.2",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@types/node": "^22.10.2",
        "prisma": "^6.1.0",
        "tsx": "^4.19.2",
        "typescript": "^5.7.2"
    }
}